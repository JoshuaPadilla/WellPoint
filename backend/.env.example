PORT=4000
DB_CONN_STRING=postgresql://postgres.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Supabase project (Google sign-in provider must be enabled in the dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Paste the real service-role key (eyJ...) if available; otherwise the raw
# JWT secret below is used to mint a short-lived service-role token (hackathon only).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Callback / redirect targets
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
