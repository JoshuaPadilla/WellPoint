PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USER=wellpoint
DB_PASSWORD=wellpoint
DB_NAME=wellpoint
# Enable TypeORM schema sync (prototype only)
DB_SYNC=true

# Google OAuth (OpenID Connect). Obtain from Google Cloud Console.
# Leave blank to disable Google sign-in (the app still boots).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT session secrets (any random strings; demo-only values below are not secret).
JWT_ACCESS_SECRET=wellpoint-dev-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=wellpoint-dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional: override the GeoJSON path used by the seeder.
# GEOJSON_PATH=../seed-data/catbalogan-brgys.geojson
