PORT=4000
DB_CONN_STRING=postgresql://postgres.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Secret used to sign/verify login JWTs. Leave empty to fall back to
# SUPABASE_JWT_SECRET if you keep it in your environment.
APP_JWT_SECRET=your-secret-min-32-chars

# Optional redirect targets (used by any future server-side redirects)
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
